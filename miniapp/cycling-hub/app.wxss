page {
  background: #f6f8fb;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
}

.container {
  padding: 28rpx;
}

.card {
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(15, 23, 42, 0.06);
  margin-bottom: 24rpx;
  padding: 28rpx;
}

.hero {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
  color: #ffffff;
}

.eyebrow {
  color: #14b8a6;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
}

.hero .eyebrow {
  color: #ccfbf1;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.25;
  margin: 12rpx 0;
}

.subtitle {
  color: #64748b;
  font-size: 27rpx;
  line-height: 1.6;
}

.hero .subtitle {
  color: #ecfeff;
}

.grid {
  display: grid;
  gap: 18rpx;
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.pill {
  background: #ecfeff;
  border-radius: 999rpx;
  color: #0f766e;
  display: inline-block;
  font-size: 24rpx;
  font-weight: 700;
  margin: 8rpx 10rpx 0 0;
  padding: 10rpx 18rpx;
}

.metric {
  background: #f8fafc;
  border-radius: 20rpx;
  padding: 22rpx;
}

.metric-value {
  color: #0f766e;
  font-size: 34rpx;
  font-weight: 800;
}

.metric-label {
  color: #64748b;
  font-size: 23rpx;
  margin-top: 6rpx;
}

.button-primary {
  background: #0f766e;
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 800;
  margin-top: 22rpx;
}

.list-item {
  border-top: 1rpx solid #e2e8f0;
  padding: 24rpx 0;
}

.list-item:first-child {
  border-top: 0;
}

.item-title {
  font-size: 30rpx;
  font-weight: 800;
}

.item-meta {
  color: #64748b;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.tag-row {
  margin-top: 12rpx;
}
